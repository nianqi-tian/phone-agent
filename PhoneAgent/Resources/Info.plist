<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Phone Agent</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>连接你的 AgentMouse 配件，把 Agent 动作转换为蓝牙鼠标和键盘操作。</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>screen-capture</string>
		<string>bluetooth-central</string>
		<string>audio</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于你主动发起的本机转写、录音及实时语音；保存原音频或发送实时音频均需分别确认。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>将你主动说出的内容识别成可编辑文字，兼容听写优先使用本机识别。</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>确认工具请求后，查找或添加你指定的日程。匹配结果将发送给你授权的 AI 服务。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>确认工具请求后，查找或添加你指定的提醒。匹配结果将发送给你授权的 AI 服务。</string>
	<key>NSContactsUsageDescription</key>
	<string>确认请求后，查找你指定的联系人，匹配的姓名、号码和邮箱会发送给你授权的 AI 服务。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>确认请求后，按日期查找你授权可见照片的元数据，结果将发送给你授权的 AI 服务。</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>确认请求后，创建和查看 Phone Agent 自己的闹钟。</string>
	<key>NSCameraUsageDescription</key>
	<string>在你开启相机对话后预览；提问发送选定画面，另行开启连续观察后定期发送多张抽样画面给你授权的 AI 服务。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.agentmouse.task</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>phoneagent</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
